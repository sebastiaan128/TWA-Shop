{
  "name": "twa-shop-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bot voor TWA Shop",
  "main": "src/bot.mjs",
  "scripts": {
    "start": "node src/bot.mjs",
    "dev": "node --watch src/bot.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "deploy:commands": "node src/deploy-commands.mjs",
    "invite:url": "node src/create-invite-url.mjs",
    "postinstall": "node scripts/sync-deploy.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "discord.js": "^14.16.0",
    "dotenv": "^18.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "vitest": "^5.0.3"
  }
}
